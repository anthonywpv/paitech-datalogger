.gradle/
.cxx/
.externalNativeBuild/
/captures/
*.apk
*.aab
*.ap_
*.dex
*.class

# --- Firma de la app --------------------------------------------------------
*.jks
*.keystore

# --- Android Studio / IntelliJ ----------------------------------------------
*.iml
.idea/
!.idea/codeStyles/
!.idea/inspectionProfiles/

# --- Sistema operativo ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

