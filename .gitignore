# --- CREDENCIALES (lo más importante) --------------------------------------
# Contiene NEON_AUTH_URL, NEON_DATA_API_URL y la ruta del SDK.
# Si esto llega a GitHub, tus endpoints de Neon quedan públicos.
local.properties

