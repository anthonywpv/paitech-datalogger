<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo_login"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/espacio_l"
        android:paddingEnd="@dimen/espacio_l"
        android:paddingTop="@dimen/espacio_xl"
        android:paddingBottom="@dimen/espacio_l">

        <!--
          El logotipo oficial lleva la palabra "aipay" en marrón #433116, el mismo
          color con el que arranca el degradado del fondo. Por eso va sobre una
          tarjeta blanca: es el tratamiento que exige la marca sobre fondo oscuro.
        -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            app:cardBackgroundColor="@color/paipay_superficie"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:contentPadding="@dimen/espacio_m">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="wrap_content"
                android:layout_height="76dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:src="@drawable/logo_paipay_completo" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:text="@string/app_subtitulo"
            android:textColor="#EAF1D4"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            app:cardCornerRadius="24dp"
            app:contentPadding="@dimen/espacio_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_titulo"
                    android:textColor="@color/paipay_marron"
                    android:textSize="@dimen/texto_titulo"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xs"
                    android:text="@string/login_mensaje"
                    android:textColor="@color/paipay_gris_bajo"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoUsuario"
                    style="@style/Paipay.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_l"
                    android:hint="@string/login_usuario_email"
                    app:startIconDrawable="@drawable/ic_usuario">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoUsuarioTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textSize="@dimen/texto_campo"
                        android:autofillHints="emailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoClave"
                    style="@style/Paipay.Campo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:hint="@string/login_clave"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_candado">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoClaveTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textSize="@dimen/texto_campo"
                        android:autofillHints="password" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sin marcar, la sesión dura solo esta subida y en la
                     siguiente se vuelven a pedir las credenciales. -->
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/casillaRecordar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:minHeight="48dp"
                    android:text="@string/login_recordar"
                    android:textColor="@color/paipay_marron"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_recordar_ayuda"
                    android:textColor="@color/paipay_gris_bajo"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/textoMensaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:background="@drawable/chip_pendiente"
                    android:padding="@dimen/espacio_s"
                    android:textColor="@color/semaforo_rojo"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonEntrar"
                    style="@style/Paipay.Boton.Principal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_l"
                    android:text="@string/login_entrar" />

                <ProgressBar
                    android:id="@+id/progreso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:indeterminateTint="@color/paipay_verde_oscuro"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:gravity="center"
            android:text="ESPOL · Prácticas Comunitarias\nPG15-PY26-04"
            android:textColor="#D8E3BE"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
