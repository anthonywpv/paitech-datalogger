<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/espacio_l"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_l"
    android:paddingBottom="@dimen/espacio_s">

    <TextView
        android:id="@+id/textoAdvertencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sync_dialogo_encabezado"
        android:textColor="@color/paipay_marron"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:background="@drawable/chip_neutro"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <TextView
            android:id="@+id/textoListaDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/paipay_marron"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bloqueAvisoDatos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/sync_titulo"
            android:src="@drawable/ic_alerta"
            app:tint="@color/semaforo_amarillo" />

        <TextView
            android:id="@+id/textoAvisoDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_s"
            android:textColor="@color/paipay_gris_bajo"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
