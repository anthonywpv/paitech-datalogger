<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ciclos_titulo"
            android:textColor="@color/paipay_marron"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/ciclos_descripcion"
            android:textColor="@color/paipay_gris_bajo" />

        <Spinner
            android:id="@+id/selectorPiscina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/textoEstadoCiclo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/chip_neutro"
            android:padding="14dp"
            android:textColor="@color/paipay_marron"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoRecordatorios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/paipay_gris_bajo" />

        <Button
            android:id="@+id/botonResolverConflicto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ciclo_resolver_conflicto"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grupoApertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/campoInicioTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/ciclo_fecha_inicio"
                android:inputType="none" />

            <EditText
                android:id="@+id/campoPoblacionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ciclo_poblacion_inicial"
                android:inputType="number" />

            <EditText
                android:id="@+id/campoDuracionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ciclo_duracion"
                android:inputType="number" />

            <EditText
                android:id="@+id/campoObservacionesAperturaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/observaciones_opcional"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/botonCalcular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ciclo_calcular_prediccion" />

            <TextView
                android:id="@+id/textoPrediccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:padding="12dp"
                android:textColor="@color/paipay_marron" />

            <Button
                android:id="@+id/botonIniciar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:enabled="false"
                android:text="@string/ciclo_iniciar" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFF6D8"
                android:padding="12dp"
                android:text="@string/ciclo_cierre_aviso"
                android:textColor="@color/paipay_marron" />

            <EditText
                android:id="@+id/campoCierreTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/ciclo_fecha_cierre"
                android:inputType="none" />

            <Spinner
                android:id="@+id/selectorDestinoCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/campoPoblacionFinalTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ciclo_poblacion_final"
                android:inputType="number" />

            <EditText
                android:id="@+id/campoPesoTotalTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/ciclo_peso_total"
                android:inputType="numberDecimal" />

            <Spinner
                android:id="@+id/selectorPiscinaDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/campoObservacionesCierreTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/observaciones_opcional"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/botonCerrar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ciclo_cerrar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
