<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/paipay_verde_claro"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/tab_agua"
                    android:src="@drawable/ic_gota"
                    app:tint="@color/paipay_verde_oscuro" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:text="Estos datos alimentan el semáforo de alertas. Mide de preferencia temprano en la mañana."
                    android:textColor="@color/paipay_marron"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoFecha"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_fecha"
            app:startIconDrawable="@drawable/ic_calendario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoFechaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPiscina"
            style="@style/Paipay.Campo.Menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_piscina">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/campoPiscinaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- El pH va primero porque no es un parámetro más: decide qué fracción
             del amonio está en su forma tóxica. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPh"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_ph"
            app:startIconDrawable="@drawable/ic_gota">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoPhTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ciclo del nitrógeno, en el orden en que ocurre: amonio → nitrito → nitrato -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoAmonio"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_amonio"
            app:startIconDrawable="@drawable/ic_alerta">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoAmonioTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNitrito"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_nitrito"
            app:startIconDrawable="@drawable/ic_oxigeno">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNitritoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoNitrato"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_nitrato"
            app:startIconDrawable="@drawable/ic_laboratorio">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoNitratoTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPoblacion"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_poblacion"
            app:helperText="@string/campo_poblacion_ayuda"
            app:startIconDrawable="@drawable/ic_pez">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoPoblacionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoObservacion"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_observacion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoObservacionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vista previa del semáforo: el productor ve el resultado ANTES de guardar -->
        <include
            android:id="@+id/vistaPreviaSemaforo"
            layout="@layout/parcial_semaforo_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            style="@style/Paipay.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/accion_guardar"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonLimpiar"
            style="@style/Paipay.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:layout_marginBottom="@dimen/espacio_l"
            android:text="@string/accion_limpiar" />
    </LinearLayout>
</ScrollView>
