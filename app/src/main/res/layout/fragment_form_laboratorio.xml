<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/paipay_verde_claro"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/tab_laboratorio"
                    android:src="@drawable/ic_laboratorio"
                    app:tint="@color/paipay_verde_oscuro" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:text="Consolidación de fuentes: aquí se registran los resultados que llegan del laboratorio, para unirlos con los datos tomados en campo."
                    android:textColor="@color/paipay_marron"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoFecha"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_fecha"
            app:startIconDrawable="@drawable/ic_calendario">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoFechaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoPiscina"
            style="@style/Paipay.Campo.Menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_piscina">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/campoPiscinaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoTipoMuestra"
            style="@style/Paipay.Campo.Menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_tipo_muestra">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/campoTipoMuestraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoParametro"
            style="@style/Paipay.Campo.Menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_parametro">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/campoParametroTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoValor"
                style="@style/Paipay.Campo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espacio_s"
                android:layout_weight="1"
                android:hint="@string/campo_valor">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoValorTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textSize="@dimen/texto_campo" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoUnidad"
                style="@style/Paipay.Campo.Menu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_s"
                android:layout_weight="1"
                android:hint="@string/campo_unidad">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/campoUnidadTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textSize="@dimen/texto_campo" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoCodigoMuestra"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_codigo_muestra">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCodigoMuestraTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoLaboratorio"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_laboratorio">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoLaboratorioTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textSize="@dimen/texto_campo" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoObservacion"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="@string/campo_observacion">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoObservacionTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            style="@style/Paipay.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/accion_guardar"
            app:icon="@drawable/ic_check" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonLimpiar"
            style="@style/Paipay.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:layout_marginBottom="@dimen/espacio_l"
            android:text="@string/accion_limpiar" />
    </LinearLayout>
</ScrollView>
