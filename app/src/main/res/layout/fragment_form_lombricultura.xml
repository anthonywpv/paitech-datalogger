<?xml version="1.0" encoding="utf-8"?>
<!--
  Lombricultura: sección declarada pero todavía sin definir.

  Se deja visible en vez de esconderla porque los lechos LOM-01 y LOM-02 son
  parte del recinto y el productor tiene que ver que la app los contempla,
  aunque de momento no le pida nada.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/icono_grande"
            android:layout_height="@dimen/icono_grande"
            android:layout_marginTop="@dimen/espacio_xl"
            android:contentDescription="@string/tab_lombricultura"
            android:src="@drawable/ic_info"
            app:tint="@color/paipay_verde_oscuro" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/lombricultura_titulo"
            android:textColor="@color/paipay_marron"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            app:cardBackgroundColor="@color/paipay_verde_claro"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:padding="@dimen/espacio_m"
                android:text="@string/lombricultura_mensaje"
                android:textColor="@color/paipay_marron"
                android:textSize="15sp" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:layout_marginBottom="@dimen/espacio_l"
            android:background="@drawable/chip_neutro"
            android:padding="@dimen/espacio_m"
            android:text="@string/lombricultura_piscinas"
            android:textColor="@color/paipay_gris_bajo"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
