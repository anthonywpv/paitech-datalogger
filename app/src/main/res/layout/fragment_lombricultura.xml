<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lombricultura"
            android:textColor="@color/paipay_marron"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:text="Cada cama tiene ciclos propios. El conteo es el número realmente observado, no una estimación."
            android:textColor="@color/paipay_gris_bajo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="Cama"
            android:textColor="@color/paipay_marron"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/selectorCama"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/chip_neutro" />

        <TextView
            android:id="@+id/textoEstadoCiclo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:text="Selecciona una cama."
            android:textColor="@color/paipay_gris_bajo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonResolverConflictoCiclo"
            style="@style/Paipay.Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:text="Resolver conflicto del ciclo"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/grupoApertura"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Iniciar ciclo"
                android:textColor="@color/paipay_marron"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Fecha y hora de inicio">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoInicioTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Conteo inicial real">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoConteoInicialTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Observaciones de apertura (opcional)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoObservacionesAperturaTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonIniciarCiclo"
                style="@style/Paipay.Boton.Principal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:text="Iniciar ciclo" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoRegistro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/textoTituloRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nuevo registro"
                android:textColor="@color/paipay_marron"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Fecha y hora del registro">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoFechaRegistroTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:text="pH del suelo (0–14)"
                android:textColor="@color/paipay_marron"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonPhMenos"
                    style="@style/Paipay.Boton.Secundario"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:text="−"
                    android:textSize="22sp" />
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoPhSuelo"
                    style="@style/Paipay.Campo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/espacio_xs"
                    android:layout_weight="1"
                    android:hint="pH">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/campoPhSueloTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonPhMas"
                    style="@style/Paipay.Boton.Secundario"
                    android:layout_width="52dp"
                    android:layout_height="56dp"
                    android:text="+"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoConteo"
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Conteo real de lombrices">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoConteoTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Observaciones (opcional)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoObservacionesRegistroTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonCancelarEdicion"
                    style="@style/Paipay.Boton.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cancelar edición"
                    android:visibility="gone" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/botonGuardarRegistro"
                    style="@style/Paipay.Boton.Principal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_xs"
                    android:layout_weight="1"
                    android:text="Guardar registro" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoCierre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar ciclo"
                android:textColor="@color/paipay_marron"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Fecha y hora de cierre">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoCierreTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Conteo final real">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoConteoFinalTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Paipay.Campo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="Observaciones de cierre (opcional)">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/campoObservacionesCierreTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCerrarCiclo"
                style="@style/Paipay.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:text="Cerrar ciclo" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="Historial de la cama"
            android:textColor="@color/paipay_marron"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/contenedorHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:layout_marginBottom="@dimen/espacio_l"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
