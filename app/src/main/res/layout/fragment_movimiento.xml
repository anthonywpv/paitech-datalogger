<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_m">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Movimiento poblacional"
            android:textColor="@color/paipay_marron"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:text="Se guarda en este teléfono y se sincroniza cuando haya conexión."
            android:textColor="@color/paipay_gris_bajo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="Tipo de movimiento"
            android:textColor="@color/paipay_marron"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/selectorTipo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/chip_neutro" />

        <LinearLayout
            android:id="@+id/grupoDireccionAjuste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Efecto del ajuste"
                android:textColor="@color/paipay_marron"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/selectorDireccionAjuste"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/chip_neutro" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoOrigen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoOrigen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Piscina de origen"
                android:textColor="@color/paipay_marron"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/selectorOrigen"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/chip_neutro" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/grupoDestino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoDestino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Piscina de destino"
                android:textColor="@color/paipay_marron"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/selectorDestino"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/chip_neutro" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoCantidad"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="Cantidad de peces">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoCantidadTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/campoFecha"
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="Fecha y hora del movimiento">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoFechaTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Paipay.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:hint="Observaciones (opcional)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/campoObservacionesTexto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textoAyuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:textColor="@color/paipay_gris_bajo"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:layout_marginBottom="@dimen/espacio_l"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonCancelar"
                style="@style/Paipay.Boton.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancelar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonGuardar"
                style="@style/Paipay.Boton.Principal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_s"
                android:layout_weight="1"
                android:text="Guardar movimiento" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
