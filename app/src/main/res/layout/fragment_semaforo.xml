<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/espacio_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/semaforo_titulo"
        android:textColor="@color/paipay_marron"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:layout_marginBottom="@dimen/espacio_m"
        android:text="@string/semaforo_descripcion"
        android:textColor="@color/paipay_gris_bajo"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textoVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/chip_neutro"
        android:padding="@dimen/espacio_l"
        android:text="@string/semaforo_sin_datos"
        android:textColor="@color/paipay_marron"
        android:textSize="15sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/espacio_l" />
</LinearLayout>
