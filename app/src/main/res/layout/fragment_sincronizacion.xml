<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="@dimen/espacio_m">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sync_titulo"
            android:textColor="@color/paipay_marron"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <!-- Estado de la conexión -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            app:cardElevation="0dp"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/puntoConexion"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:background="@drawable/punto_gris" />

                <TextView
                    android:id="@+id/textoConexion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:textColor="@color/paipay_marron"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Resumen de pendientes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Paipay.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Datos guardados en el teléfono" />

                <TextView
                    android:id="@+id/textoTotalPendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xs"
                    android:textColor="@color/paipay_verde_oscuro"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoDetallePendientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_xs"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/paipay_gris_bajo"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/textoUltimaSync"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:textColor="@color/paipay_gris_alto"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSincronizar"
            style="@style/Paipay.Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/sync_boton"
            app:icon="@drawable/ic_nube_subir" />

        <LinearLayout
            android:id="@+id/bloqueProgreso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateTint="@color/paipay_verde_oscuro" />

            <TextView
                android:id="@+id/textoProgreso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_m"
                android:textColor="@color/paipay_marron"
                android:textSize="15sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:layout_marginBottom="@dimen/espacio_l"
            app:cardBackgroundColor="@color/paipay_verde_claro"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/sync_titulo"
                    android:src="@drawable/ic_info"
                    app:tint="@color/paipay_verde_oscuro" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_m"
                    android:text="@string/sync_ayuda"
                    android:textColor="@color/paipay_marron"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
