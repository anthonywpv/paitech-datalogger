<?xml version="1.0" encoding="utf-8"?>
<!-- Una alerta del semáforo. Sirve tanto para las buenas como para las malas:
     el color y el punto son lo que las distingue. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tarjetaAlerta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s"
    app:cardCornerRadius="@dimen/radio_tarjeta"
    app:cardElevation="0dp"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/espacio_m">

        <View
            android:id="@+id/puntoAlerta"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/punto_gris" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textoAlertaTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/paipay_marron"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoAlertaDetalle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/paipay_marron"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textoAlertaAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_xs"
                android:textColor="@color/paipay_gris_bajo"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
