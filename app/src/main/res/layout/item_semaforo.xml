<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_m"
    app:cardElevation="0dp"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/punto"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/punto_gris" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textoPiscina"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/paipay_marron"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/paipay_gris_bajo"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textoEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/textoResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:textColor="@color/paipay_marron"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/contenedorLecturas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/bloqueAccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:background="@drawable/fondo_hoja_blanca"
            android:orientation="horizontal"
            android:padding="@dimen/espacio_m"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/semaforo_titulo"
                android:src="@drawable/ic_alerta"
                app:tint="@color/paipay_marron" />

            <TextView
                android:id="@+id/textoAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_s"
                android:textColor="@color/paipay_marron"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
